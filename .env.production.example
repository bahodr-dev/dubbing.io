NODE_ENV=production
PORT=5000
APP_URL=https://dubla.uz
DUBBING_DB_PATH=/var/lib/dubla/database/dubbing.db
DUBBING_UPLOADS_DIR=/var/lib/dubla/media
BETA_INVITE_REQUIRED=true
MAX_MEDIA_DURATION_SECONDS=900
TRANSCRIPTION_MAX_BYTES=25165824
PROVIDER_CONCURRENCY=2
DISK_WARNING_PERCENT=70
DISK_CRITICAL_PERCENT=85
JWT_SECRET=
OAUTH_STATE_SECRET=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_TEST_MODE=false
SENTRY_DSN=
APP_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_APP_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Internal Cinema preview. Keep disabled until the five-scene listening review passes.
CINEMA_ENABLED=false
CINEMA_USER_IDS=
FAL_KEY=
GEMINI_API_KEY=

# Film/series internal beta: configure ceilings in Studio before paid work.
FILM_ADMIN_USER_IDS=
MAX_FILM_DURATION_SECONDS=21600
# Exact number of trusted reverse-proxy hops (0 = direct backend).
TRUST_PROXY_HOPS=0

# Primary dubbing setup: OpenAI, FAL, ElevenLabs, Gemini
TRANSLATION_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TRANSCRIPTION_PROVIDER=openai
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2
# Gemini compares character voice samples across scenes.
FILM_IDENTITY_PROVIDER=gemini
FILM_SEPARATION_PROVIDER=fal
TTS_PROVIDER=elevenlabs
