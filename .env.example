# Dubbing.io Environment Configuration Template
# Copy this file to .env and set your environment variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Security (REQUIRED)
# Generate a strong 256-bit secret key, e.g. using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# AI Dubbing & Speech Synthesis Providers (Optional for mock mode / Required for real APIs)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPL_API_KEY=
