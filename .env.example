# Dubbing.io Environment Configuration Template
# Copy this file to .env and set your environment variables

# Server & Application Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Security (REQUIRED)
# Generate a strong 256-bit secret key: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
SESSION_SECRET=your_super_secret_session_key_here
OAUTH_STATE_SECRET=your_super_secret_oauth_state_key_here

# 1. Google OAuth 2.0 / OpenID Connect
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback (or production domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# 2. GitHub OAuth
# Obtain from GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# 3. Microsoft Identity Platform / Azure Entra ID
# Obtain from Microsoft Entra Admin Center -> App registrations -> Authentication -> Web
# Redirect URI: http://localhost:5000/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# AI Dubbing & Speech Synthesis Providers (Optional for mock mode / Required for production neural pipelines)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPL_API_KEY=

# Payme Merchant Payment Provider
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_merchant_secret_key
PAYME_TEST_MODE=true

# Click Merchant Payment Provider
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_merchant_secret_key
CLICK_TEST_MODE=true

